    esac
  ;;
esac
\n'*}
      [[ $status == 200 && $body == '{"status":"ok"}' ]] && return 0
    fi
    sleep 0.5
  done
  print -u2 -r -- "Skills MCP local server is not ready at $url."
  return 1
}

