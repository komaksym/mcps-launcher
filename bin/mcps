#!/bin/zsh

set -u
setopt NO_NOMATCH
unsetopt BG_NICE

readonly STATE_DIR="${MCP_LAUNCHER_STATE_DIR:-$HOME/.local/state/mcp-launcher}"
readonly PROFILE_DIR="${TUNNEL_CLIENT_PROFILE_DIR:-$HOME/.config/tunnel-client}"
readonly TUNNEL_BIN="${TUNNEL_CLIENT_BIN:-/usr/local/bin/tunnel-client}"
readonly PS_BIN="${MCP_LAUNCHER_PS_BIN:-/bin/ps}"
readonly STARTUP_WAIT="${MCP_LAUNCHER_STARTUP_WAIT:-1}"
readonly PLAYWRIGHT_USER_DATA_DIR="${PLAYWRIGHT_MCP_USER_DATA_DIR:-$HOME/.playwright-spotify}"

mkdir -p "$STATE_DIR" || exit 1

label() {
  [[ $1 == chrome ]] && print -r -- "Chrome MCP" || print -r -- "Playwright MCP"
}

pid_file() { print -r -- "$STATE_DIR/$1.pid"; }
log_file() { print -r -- "$STATE_DIR/$1.log"; }
health_file() { print -r -- "$STATE_DIR/$1-health.url"; }
mode_file() { print -r -- "$STATE_DIR/playwright.mode"; }

read_pid() {
  local file pid
  file=$(pid_file "$1")
  [[ -f $file ]] || return 1
  IFS= read -r pid < "$file" || return 1
  [[ $pid == <-> ]] || return 1
  print -r -- "$pid"
}

process_matches() {
  local kind=$1 pid=$2 command expected
  kill -0 "$pid" 2>/dev/null || return 1
  command=$("$PS_BIN" -p "$pid" -o command= 2>/dev/null) || return 1
  expected=$([[ $kind == chrome ]] && print chrome-browser-mcp || print playwright)
  [[ $command == *tunnel-client* && $command == *"$expected"* ]]
}

running_pid() {
  local kind=$1 pid file
  file=$(pid_file "$kind")
  if ! pid=$(read_pid "$kind") || ! process_matches "$kind" "$pid"; then
    [[ -f $file ]] && rm -f "$file"
    [[ $kind == playwright ]] && rm -f "$(mode_file)"
    return 1
  fi
  print -r -- "$pid"
}

read_mode() {
  local file mode
  file=$(mode_file)
  [[ -f $file ]] || return 1
  IFS= read -r mode < "$file" || return 1
  [[ $mode == headed || $mode == headless ]] || return 1
  print -r -- "$mode"
}

playwright_command() {
  local mode=$1 quoted_dir
  quoted_dir=${(q)PLAYWRIGHT_USER_DATA_DIR}
  if [[ $mode == headless ]]; then
    print -r -- "npx -y @playwright/mcp@latest --headless --user-data-dir=$quoted_dir"
  else
    print -r -- "npx -y @playwright/mcp@latest --user-data-dir=$quoted_dir"
  fi
}

ensure_chrome_server() {
  [[ ${MCP_LAUNCHER_SKIP_CHROME_OPEN:-0} == 1 ]] && return 0
  nc -z 127.0.0.1 2091 >/dev/null 2>&1 && return 0
  if [[ -d "/Applications/Google Chrome.app" ]]; then
    open -a "Google Chrome" >/dev/null 2>&1 || true
    local i
    for i in {1..20}; do
      nc -z 127.0.0.1 2091 >/dev/null 2>&1 && return 0
      sleep 0.5
    done
  fi
  print -u2 -r -- "Chrome MCP local server is not ready on 127.0.0.1:2091."
  print -u2 -r -- "Open Chrome and enable extension jlpddlfiallighiohmhhkemgbhofpnha."
  return 1
}

start_chrome() {
  local pid pfile logfile hfile child
  if pid=$(running_pid chrome); then
    print -r -- "Chrome MCP is already running (PID $pid)."
    return 0
  fi
  [[ -x $TUNNEL_BIN ]] || {
    print -u2 -r -- "tunnel-client not executable: $TUNNEL_BIN"
    return 1
  }
  ensure_chrome_server || return 1

  pfile=$(pid_file chrome)
  logfile=$(log_file chrome)
  hfile=$(health_file chrome)
  : >> "$logfile"
  rm -f "$pfile" "$hfile"

  nohup env -u CONTROL_PLANE_TUNNEL_ID "$TUNNEL_BIN" run \
    --profile chrome-browser-mcp \
    --profile-dir "$PROFILE_DIR" \
    --pid.file "$pfile" \
    --log.file "$logfile" \
    --health.listen-addr "127.0.0.1:0" \
    --health.url-file "$hfile" \
    </dev/null >/dev/null 2>&1 &
  child=$!
  sleep "$STARTUP_WAIT"

  if pid=$(running_pid chrome); then
    print -r -- "Chrome MCP started (PID $pid)."
    return 0
  fi
  if kill -0 "$child" 2>/dev/null; then
    print -r -- "$child" > "$pfile"
    print -r -- "Chrome MCP started (PID $child)."
    return 0
  fi
  rm -f "$pfile" "$hfile"
  print -u2 -r -- "Chrome MCP failed to start. See $logfile"
  tail -n 10 "$logfile" >&2 2>/dev/null || true
  return 1
}

start_playwright() {
  local mode=$1 pid current pfile logfile hfile child command
  if pid=$(running_pid playwright); then
    current=$(read_mode 2>/dev/null || true)
    if [[ $current == "$mode" ]]; then
      print -r -- "Playwright MCP is already running in $mode mode (PID $pid)."
      return 0
    fi
    stop_playwright >/dev/null || return 1
  fi
  [[ -x $TUNNEL_BIN ]] || {
    print -u2 -r -- "tunnel-client not executable: $TUNNEL_BIN"
    return 1
  }

  pfile=$(pid_file playwright)
  logfile=$(log_file playwright)
  hfile=$(health_file playwright)
  command=$(playwright_command "$mode")
  : >> "$logfile"
  rm -f "$pfile" "$hfile"

  nohup env -u CONTROL_PLANE_TUNNEL_ID "$TUNNEL_BIN" run \
    --profile playwright \
    --profile-dir "$PROFILE_DIR" \
    --mcp.command "$command" \
    --pid.file "$pfile" \
    --log.file "$logfile" \
    --health.listen-addr "127.0.0.1:0" \
    --health.url-file "$hfile" \
    </dev/null >/dev/null 2>&1 &
  child=$!
  sleep "$STARTUP_WAIT"

  if pid=$(running_pid playwright); then
    print -r -- "$mode" > "$(mode_file)"
    print -r -- "Playwright MCP started in $mode mode (PID $pid)."
    return 0
  fi
  if kill -0 "$child" 2>/dev/null; then
    print -r -- "$child" > "$pfile"
    print -r -- "$mode" > "$(mode_file)"
    print -r -- "Playwright MCP started in $mode mode (PID $child)."
    return 0
  fi
  rm -f "$pfile" "$hfile" "$(mode_file)"
  print -u2 -r -- "Playwright MCP failed to start. See $logfile"
  tail -n 10 "$logfile" >&2 2>/dev/null || true
  return 1
}

stop_kind() {
  local kind=$1 pid i name
  name=$(label "$kind")
  if ! pid=$(running_pid "$kind"); then
    rm -f "$(health_file "$kind")"
    [[ $kind == playwright ]] && rm -f "$(mode_file)"
    print -r -- "$name is not running."
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null || true
  for i in {1..50}; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if process_matches "$kind" "$pid"; then
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$(pid_file "$kind")" "$(health_file "$kind")"
  [[ $kind == playwright ]] && rm -f "$(mode_file)"
  print -r -- "$name stopped."
}

stop_playwright() { stop_kind playwright; }

status_chrome() {
  local pid
  if pid=$(running_pid chrome); then
    print -r -- "Chrome MCP: running (PID $pid)"
  else
    print -r -- "Chrome MCP: stopped"
  fi
}

status_playwright() {
  local pid mode
  if pid=$(running_pid playwright); then
    mode=$(read_mode 2>/dev/null || print unknown)
    print -r -- "Playwright MCP: running ($mode, PID $pid)"
  else
    rm -f "$(mode_file)"
    print -r -- "Playwright MCP: stopped"
  fi
}

show_status() {
  status_chrome
  status_playwright
}

start_both() {
  start_chrome
  local chrome_status=$?
  start_playwright headless
  return $(( chrome_status || $? ))
}

stop_target() {
  case $1 in
    chrome|playwright) stop_kind "$1" ;;
    both)
      stop_kind chrome
      stop_kind playwright
      ;;
    *)
      print -u2 -r -- "Usage: mcps stop {chrome|playwright|both}"
      return 2
      ;;
  esac
}

restart_target() {
  case $1 in
    chrome) stop_kind chrome && start_chrome ;;
    playwright|playwright-headless) stop_kind playwright && start_playwright headless ;;
    playwright-head) stop_kind playwright && start_playwright headed ;;
    both) stop_target both && start_both ;;
    *)
      print -u2 -r -- "Usage: mcps restart {chrome|playwright|playwright-head|playwright-headless|both}"
      return 2
      ;;
  esac
}

show_logs() {
  local kind=$1 file
  [[ $kind == chrome || $kind == playwright ]] || {
    print -u2 -r -- "Usage: mcps logs {chrome|playwright}"
    return 2
  }
  file=$(log_file "$kind")
  touch "$file"
  tail -n 50 -f "$file"
}

menu() {
  while true; do
    print -r -- ""
    print -r -- "1) Start Chrome MCP"
    print -r -- "2) Start Playwright MCP (headed)"
    print -r -- "3) Start Playwright MCP (headless)"
    print -r -- "4) Start Chrome + headless Playwright"
    print -r -- "5) Show status"
    print -r -- "6) Stop Chrome MCP"
    print -r -- "7) Stop Playwright MCP"
    print -r -- "8) Stop both"
    print -r -- "9) Restart Playwright MCP (headed)"
    print -r -- "10) Restart Playwright MCP (headless)"
    print -r -- "q) Quit"
    print -n -r -- "> "
    local choice
    IFS= read -r choice || return 0
    case $choice in
      1) start_chrome ;;
      2) start_playwright headed ;;
      3) start_playwright headless ;;
      4) start_both ;;
      5) show_status ;;
      6) stop_kind chrome ;;
      7) stop_kind playwright ;;
      8) stop_target both ;;
      9) restart_target playwright-head ;;
      10) restart_target playwright-headless ;;
      q|Q) return 0 ;;
      *) print -u2 -r -- "Invalid choice." ;;
    esac
  done
}

case "${0:t}" in
  mcp-chrome) start_chrome ;;
  mcp-playwright-head) start_playwright headed ;;
  mcp-playwright-headless|mcp-playwright) start_playwright headless ;;
  *)
    case ${1:-} in
      "") menu ;;
      chrome) start_chrome ;;
      playwright-head) start_playwright headed ;;
      playwright-headless|playwright) start_playwright headless ;;
      both) start_both ;;
      status) show_status ;;
      stop) stop_target "${2:-}" ;;
      restart) restart_target "${2:-}" ;;
      logs) show_logs "${2:-}" ;;
      *)
        print -u2 -r -- "Usage: mcps [chrome|playwright|playwright-head|playwright-headless|both|status|stop TARGET|restart TARGET|logs TARGET]"
        exit 2
        ;;
    esac
  ;;
esac
