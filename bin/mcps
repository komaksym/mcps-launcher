}

restart_target() {
  local target=$1 stop_target_name
  stop_target_name=${RESTART_STOP_TARGETS[$target]:-}
  [[ -n $stop_target_name ]] || {
    print -u2 -r -- "Usage: mcps restart {chrome|playwright|playwright-head|playwright-headless|skills|both|all}"
    return 2
  }
  stop_target "$stop_target_name" && start_target "$target"
}

show_logs() {
  local kind=$1 file
  [[ -n ${LOG_TARGETS[$kind]:-} ]] || {
    print -u2 -r -- "Usage: mcps logs {chrome|playwright|skills}"
    return 2
  }
  file=$(log_file "$kind")
  touch "$file"
  if [[ $kind == skills ]]; then
    touch "$(log_file skills-server)"
    if [[ ${MCP_LAUNCHER_LOG_FOLLOW:-1} == 1 ]]; then
      tail -n 50 -f "$(log_file skills-server)" "$file"
    else
      tail -n 50 "$(log_file skills-server)" "$file"
    fi
  elif [[ ${MCP_LAUNCHER_LOG_FOLLOW:-1} == 1 ]]; then
    tail -n 50 -f "$file"
  else
    tail -n 50 "$file"
  fi
}

menu() {
  while true; do
    print -r -- ""
    print -r -- "1) Start Chrome MCP"
    print -r -- "2) Start Playwright MCP (headed)"
    print -r -- "3) Start Playwright MCP (headless)"
    print -r -- "4) Start Chrome + headless Playwright + Skills"
    print -r -- "5) Show status"
    print -r -- "6) Stop Chrome MCP"
    print -r -- "7) Stop Playwright MCP"
    print -r -- "8) Stop all"
    print -r -- "9) Restart Playwright MCP (headed)"
    print -r -- "10) Restart Playwright MCP (headless)"
    print -r -- "11) Start Skills MCP"
    print -r -- "12) Restart Skills MCP"
    print -r -- "q) Quit"
    print -n -r -- "> "
    local choice
    IFS= read -r choice || return 0
    case $choice in
      1) start_target chrome ;;
      2) start_target playwright-head ;;
      3) start_target playwright-headless ;;
      4) start_target all ;;
      5) show_status ;;
      6) stop_kind chrome ;;
      7) stop_kind playwright ;;
      8) stop_target all ;;
      9) restart_target playwright-head ;;
      10) restart_target playwright-headless ;;
      11) start_target skills ;;
      12) restart_target skills ;;
      q|Q) return 0 ;;
      *) print -u2 -r -- "Invalid choice." ;;
    esac
  done
}

case "${0:t}" in
  mcp-chrome) start_target chrome ;;
  mcp-playwright-head) start_target playwright-head ;;
  mcp-playwright-headless|mcp-playwright) start_target playwright-headless ;;
  mcp-skills) start_target skills ;;
  *)
    case ${1:-} in
      "") menu ;;
      status) show_status ;;
      stop) stop_target "${2:-}" ;;
      restart) restart_target "${2:-}" ;;
      logs) show_logs "${2:-}" ;;
      *) start_target "${1:-}" ;;
    esac
  ;;
esac
